# Copie este arquivo para ".env" (na raiz do repositório) e preencha com as credenciais reais.
# connectTimeout: se estiver sem internet, desiste em 10s em vez de ficar travado.
DB_URL=jdbc:mysql://SEU_HOST:PORTA/integradorarcade?sslMode=REQUIRED&connectTimeout=10000
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
